location                    = "westeurope"
application_name            = "entropy-data-prod"
container_image             = "entropydata/entropy-data:latest" #  entropydata/entropy-data-ce:latest for Community Edition

container_cpu               = 2
container_memory            = "4Gi"

postgres_sku                = "GP_Standard_D2s_v3"
postgres_storage_gb         = 128
postgres_storage_tier       = "P15"

smtp_password               = "CHANGE_ME"

application_host_web                            = "https://entropy-data.example.com"
application_mail_from                           = "support@example.com"

# Standard SMTP settings (required when acs_email_enabled = false)
mail_host                                       = "smtp.example.com"
mail_port                                       = "587"
mail_username                                   = "smtp-user"
mail_properties_mail_smtp_auth                  = "true"
mail_properties_mail_smtp_starttls_enable       = "true"

# Alternative: Azure Communication Services SMTP mode
# acs_email_enabled   = true
# When ACS is enabled, mail_host/mail_port/mail_username above are optional.
# acs_data_location   = "Europe" # default
# acs_sender_username = "noreply" # default
# ACS SMTP password has no generated default; provide it securely at apply time.
# acs_mail_from       = "noreply@<your-verified-domain>"

# Optional Azure SSO (Enterprise Edition)
# sso_azure_enabled        = true
# sso_azure_issuer_uri     = "https://login.microsoftonline.com/<tenant-id>/v2.0"
# sso_azure_client_id      = "<client-id>"
# sso_azure_client_secret  = "<client-secret>"
# sso_azure_hosts          = "entropy-data.example.com"

additional_env_vars = {
  # Optional examples
#  APPLICATION_SUPERADMINS                      = "admin1@example.com,admin2@example.com"
}
